# Server Configuration
PORT=8080
TZ=Asia/Jakarta

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=petualangan_cuan
DB_PORT=5432

# Security & Authentication (JWT)
# Generate a secure key using: openssl rand -base64 32
JWT_SECRET=your_generated_jwt_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=72h

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Frontend Integration (CORS)
FRONTEND_URL=http://localhost:5173

# AI Provider Configuration
# Pilih provider: "local" (default) atau "external"
AI_PROVIDER=local

# Local AI Services (digunakan saat AI_PROVIDER=local)
LOCAL_LLM_URL=http://localhost:8081
LOCAL_WHISPER_URL=http://localhost:8000

# External AI API (digunakan saat AI_PROVIDER=external)
# Contoh: OpenRouter, OpenAI, Groq, Google Gemini dsb.
EXTERNAL_AI_URL=https://openrouter.ai/api/v1/chat/completions
EXTERNAL_AI_API_KEY=your_external_api_key_here
EXTERNAL_AI_MODEL=openrouter/free

# WA Gateway Integration
WA_GATEWAY_URL=http://localhost:3003
WA_GATEWAY_USERNAME=yourusername
WA_GATEWAY_PASSWORD=yourpassword
# Generate a secure hook secret using: openssl rand -base64 32
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret
